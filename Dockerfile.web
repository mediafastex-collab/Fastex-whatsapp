FROM node:20-bookworm-slim AS base
WORKDIR /app
ENV NODE_ENV=production

RUN npm install -g pnpm@9.4.0

FROM base AS builder
WORKDIR /app
COPY package.json pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
COPY apps/web ./apps/web

RUN pnpm install --frozen-lockfile=false
RUN pnpm --filter @fastex/database run db:generate
RUN pnpm --filter @fastex/shared run build
RUN pnpm --filter @fastex/database run build
RUN pnpm --filter @fastex/web run build

FROM base AS runner
WORKDIR /app

COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/web ./apps/web

EXPOSE 3000
ENV PORT=3000

CMD ["node", "apps/web/node_modules/.bin/next", "start", "-p", "3000"]
