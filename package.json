{
  "name": "fastex-whatsapp-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "WhatsApp Web QR-Scanner Integration - Production Monorepo",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "pages:build": "pnpm -r run build && npx -y @cloudflare/next-on-pages@1",
    "cf-build": "pnpm -r run build && npx -y @cloudflare/next-on-pages@1",
    "test": "jest --runInBand",
    "db:generate": "pnpm --filter @fastex/database run db:generate",
    "db:push": "pnpm --filter @fastex/database run db:push",
    "db:seed": "pnpm --filter @fastex/database run db:seed"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  },
  "packageManager": "pnpm@9.4.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
